{
  "name": "mero-telecom",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mero-telecom/web --filter @mero-telecom/api dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "cross-env DATABASE_URL=postgresql://mero_telecom:mero_telecom_test_password@localhost:5433/mero_telecom_test REDIS_URL=redis://localhost:6380 pnpm --filter @mero-telecom/api test:e2e",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "services:test:up": "docker compose --profile test up -d postgres-test redis-test",
    "services:test:down": "docker compose --profile test stop postgres-test redis-test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "cross-env": "^10.1.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.7.4",
    "typescript-eslint": "8.67.0"
  }
}
