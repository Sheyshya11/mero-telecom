generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  CUSTOMER
}

enum CustomerStatus {
  INVITATION_PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserStatus {
  INVITATION_PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AddressType {
  RESIDENTIAL
  SERVICE
  BILLING
}

enum AccountInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AccountInvitationReason {
  ONLINE_PURCHASE
  ADMIN_CREATED
  RESEND
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum CheckoutApplicationStatus {
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  REQUIRES_REVIEW
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
}

enum PlanChangeType {
  UPGRADE
  DOWNGRADE
}

enum PlanChangeStatus {
  PENDING
  CHECKOUT_CREATED
  PROCESSING
  SCHEDULED
  APPLIED
  FAILED
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum AccessTechnology {
  FTTP
  FTTN
  FTTC
  HFC
  FIXED_WIRELESS
  SATELLITE
}

enum OperatingRegionStatus {
  ACTIVE
  COMING_SOON
  DISABLED
}

enum PostcodeCoverageStatus {
  AVAILABLE
  PARTIAL
  COMING_SOON
  UNAVAILABLE
}

enum AddressOverrideStatus {
  AVAILABLE
  UNAVAILABLE
  MANUAL_REVIEW
}

enum CoverageResultStatus {
  AVAILABLE
  COMING_SOON
  NOT_AVAILABLE
  OUTSIDE_OPERATING_REGION
  MANUAL_REVIEW
}

model User {
  id                       String               @id @default(uuid()) @db.Uuid
  email                    String               @unique @db.VarChar(320)
  displayName              String?              @db.VarChar(200)
  passwordHash             String?              @db.VarChar(255)
  role                     Role                 @default(CUSTOMER)
  isActive                 Boolean              @default(true)
  status                   UserStatus           @default(ACTIVE)
  emailVerifiedAt          DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  customer                 Customer?
  refreshSessions          RefreshSession[]
  passwordResetTokens      PasswordResetToken[]
  auditLogs                AuditLog[]           @relation("AuditActor")
  invitations              AccountInvitation[]  @relation("InvitationUser")
  issuedInvitations        AccountInvitation[]  @relation("InvitationIssuer")
  staffInvitationsIssued   StaffInvitation[]    @relation("StaffInvitationIssuer")
  staffInvitationsAccepted StaffInvitation[]    @relation("StaffInvitationAcceptor")
}

model Customer {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String?               @unique @db.Uuid
  stripeCustomerId     String?               @unique @db.VarChar(255)
  customerNumber       String                @unique @db.VarChar(32)
  firstName            String                @db.VarChar(100)
  lastName             String                @db.VarChar(100)
  email                String                @unique @db.VarChar(320)
  phone                String                @db.VarChar(32)
  addressLine1         String                @db.VarChar(255)
  addressLine2         String?               @db.VarChar(255)
  suburb               String                @db.VarChar(100)
  state                String                @db.VarChar(3)
  postcode             String                @db.VarChar(10)
  status               CustomerStatus        @default(ACTIVE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptions        Subscription[]
  invoices             Invoice[]
  payments             Payment[]
  addresses            CustomerAddress[]
  checkoutApplications CheckoutApplication[]
  planChangeRequests   PlanChangeRequest[]
  coverageSearches     CoverageSearch[]

  @@index([lastName, firstName])
  @@index([status])
}

model CustomerAddress {
  id           String      @id @default(uuid()) @db.Uuid
  customerId   String      @db.Uuid
  type         AddressType
  addressLine1 String      @db.VarChar(255)
  addressLine2 String?     @db.VarChar(255)
  suburb       String      @db.VarChar(100)
  state        String      @db.VarChar(3)
  postcode     String      @db.VarChar(10)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, type])
  @@index([postcode])
}

model InvoiceDocument {
  id         String   @id @default(uuid()) @db.Uuid
  invoiceId  String   @unique @db.Uuid
  storageKey String   @unique @db.VarChar(1024)
  mimeType   String   @db.VarChar(255)
  sizeBytes  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model InternetPlan {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String                @unique @db.VarChar(150)
  description          String?               @db.Text
  highlights           String[]              @default([])
  downloadMbps         Int
  uploadMbps           Int
  monthlyCents         Int
  isActive             Boolean               @default(true)
  isPublic             Boolean               @default(true)
  isAvailable          Boolean               @default(true)
  tierRank             Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  subscriptions        Subscription[]
  purchaseInvoices     Invoice[]             @relation("InvoicePurchasePlan")
  checkoutApplications CheckoutApplication[]
  sourcePlanChanges    PlanChangeRequest[]   @relation("PlanChangeSourcePlan")
  targetPlanChanges    PlanChangeRequest[]   @relation("PlanChangeTargetPlan")
  coverageRules        PlanCoverageRule[]

  @@index([isActive])
  @@index([isPublic, isAvailable, tierRank])
}

model Subscription {
  id                  String               @id @default(uuid()) @db.Uuid
  customerId          String               @db.Uuid
  planId              String               @db.Uuid
  status              SubscriptionStatus   @default(PENDING)
  startDate           DateTime             @db.Date
  endDate             DateTime?            @db.Date
  endReason           String?              @db.VarChar(100)
  billingCycle        BillingCycle         @default(MONTHLY)
  billingAnchorDay    Int
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan                InternetPlan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices            Invoice[]
  checkoutApplication CheckoutApplication?
  sourcePlanChanges   PlanChangeRequest[]  @relation("PlanChangeSourceSubscription")
  resultingPlanChange PlanChangeRequest?   @relation("PlanChangeResultSubscription")

  @@index([customerId, status])
  @@index([planId])
}

model Invoice {
  id                  String               @id @default(uuid()) @db.Uuid
  invoiceNumber       String               @unique @db.VarChar(32)
  customerId          String               @db.Uuid
  subscriptionId      String?              @db.Uuid
  purchasePlanId      String?              @db.Uuid
  issueDate           DateTime             @db.Date
  dueDate             DateTime             @db.Date
  subtotalCents       Int
  taxCents            Int
  totalCents          Int
  currency            String               @default("AUD") @db.Char(3)
  status              InvoiceStatus        @default(DRAFT)
  pdfUrl              String?              @db.VarChar(2048)
  issuedAt            DateTime?
  paidAt              DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subscription        Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  purchasePlan        InternetPlan?        @relation("InvoicePurchasePlan", fields: [purchasePlanId], references: [id], onDelete: Restrict)
  items               InvoiceItem[]
  payments            Payment[]
  documents           InvoiceDocument[]
  checkoutApplication CheckoutApplication?
  planChangeRequest   PlanChangeRequest?

  @@unique([subscriptionId, issueDate])
  @@index([customerId, status])
  @@index([dueDate, status])
  @@index([subscriptionId])
  @@index([purchasePlanId])
}

model InvoiceItem {
  id             String  @id @default(uuid()) @db.Uuid
  invoiceId      String  @db.Uuid
  description    String  @db.VarChar(500)
  quantity       Int
  unitPriceCents Int
  amountCents    Int
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id                  String                @id @default(uuid()) @db.Uuid
  invoiceId           String                @db.Uuid
  customerId          String                @db.Uuid
  provider            PaymentProvider
  providerPaymentId   String?               @db.VarChar(255)
  providerSessionId   String?               @unique @db.VarChar(255)
  amountCents         Int
  currency            String                @default("AUD") @db.Char(3)
  status              PaymentStatus         @default(PENDING)
  paidAt              DateTime?
  createdAt           DateTime              @default(now())
  invoice             Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customer            Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  webhookEvents       PaymentWebhookEvent[]
  checkoutApplication CheckoutApplication?
  planChangeRequest   PlanChangeRequest?

  @@unique([provider, providerPaymentId])
  @@index([invoiceId, status])
  @@index([customerId])
}

model CheckoutApplication {
  id                      String                    @id @default(uuid()) @db.Uuid
  planId                  String                    @db.Uuid
  applicantEmail          String                    @db.VarChar(320)
  firstName               String                    @db.VarChar(100)
  lastName                String                    @db.VarChar(100)
  phone                   String                    @db.VarChar(32)
  residentialAddress      Json
  serviceAddress          Json
  billingAddress          Json
  termsAcceptedAt         DateTime
  privacyAcceptedAt       DateTime
  status                  CheckoutApplicationStatus @default(PENDING_PAYMENT)
  amountCents             Int
  currency                String                    @default("AUD") @db.Char(3)
  stripeCheckoutSessionId String?                   @unique @db.VarChar(255)
  stripePaymentIntentId   String?                   @unique @db.VarChar(255)
  stripeCustomerId        String?                   @db.VarChar(255)
  customerId              String?                   @unique @db.Uuid
  invoiceId               String?                   @unique @db.Uuid
  paymentId               String?                   @unique @db.Uuid
  subscriptionId          String?                   @unique @db.Uuid
  expiresAt               DateTime
  completedAt             DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  plan                    InternetPlan              @relation(fields: [planId], references: [id], onDelete: Restrict)
  customer                Customer?                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice                 Invoice?                  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payment                 Payment?                  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  subscription            Subscription?             @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  invitations             AccountInvitation[]

  @@index([status, expiresAt])
  @@index([applicantEmail])
  @@index([createdAt])
}

model AccountInvitation {
  id                    String                  @id @default(uuid()) @db.Uuid
  userId                String                  @db.Uuid
  tokenHash             String                  @unique @db.Char(64)
  status                AccountInvitationStatus @default(PENDING)
  reason                AccountInvitationReason
  createdByUserId       String?                 @db.Uuid
  checkoutApplicationId String?                 @db.Uuid
  expiresAt             DateTime
  sentAt                DateTime?
  acceptedAt            DateTime?
  createdAt             DateTime                @default(now())
  user                  User                    @relation("InvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy             User?                   @relation("InvitationIssuer", fields: [createdByUserId], references: [id], onDelete: SetNull)
  checkoutApplication   CheckoutApplication?    @relation(fields: [checkoutApplicationId], references: [id], onDelete: SetNull)

  @@index([userId, status, expiresAt])
  @@index([createdByUserId, createdAt])
}

model StaffInvitation {
  id           String                @id @default(uuid()) @db.Uuid
  email        String                @db.VarChar(320)
  role         Role
  tokenHash    String                @unique @db.Char(64)
  status       StaffInvitationStatus @default(PENDING)
  expiresAt    DateTime
  invitedById  String?               @db.Uuid
  acceptedById String?               @db.Uuid
  acceptedAt   DateTime?
  revokedAt    DateTime?
  sentAt       DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  invitedBy    User?                 @relation("StaffInvitationIssuer", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy   User?                 @relation("StaffInvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([email, status, expiresAt])
  @@index([invitedById, createdAt])
  @@index([status, expiresAt])
}

model PaymentWebhookEvent {
  id                  String             @id @default(uuid()) @db.Uuid
  provider            PaymentProvider
  providerEventId     String             @unique @db.VarChar(255)
  eventType           String             @db.VarChar(100)
  paymentId           String?            @db.Uuid
  planChangeRequestId String?            @db.Uuid
  processedAt         DateTime           @default(now())
  payment             Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  planChangeRequest   PlanChangeRequest? @relation(fields: [planChangeRequestId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([planChangeRequestId])
}

model PlanChangeRequest {
  id                         String                @id @default(uuid()) @db.Uuid
  customerId                 String                @db.Uuid
  sourceSubscriptionId       String                @db.Uuid
  newSubscriptionId          String?               @unique @db.Uuid
  sourcePlanId               String                @db.Uuid
  targetPlanId               String                @db.Uuid
  type                       PlanChangeType
  status                     PlanChangeStatus      @default(PENDING)
  currency                   String                @default("AUD") @db.Char(3)
  sourcePlanPriceCents       Int
  targetPlanPriceCents       Int
  unusedCreditCents          Int
  proratedTargetCents        Int
  amountPayableCents         Int
  currentPeriodStartSnapshot DateTime
  currentPeriodEndSnapshot   DateTime
  requestedAt                DateTime              @default(now())
  effectiveAt                DateTime
  stripeCheckoutSessionId    String?               @unique @db.VarChar(255)
  stripePaymentIntentId      String?               @unique @db.VarChar(255)
  invoiceId                  String?               @unique @db.Uuid
  paymentId                  String?               @unique @db.Uuid
  failureReason              String?               @db.VarChar(255)
  cancellationReason         String?               @db.VarChar(255)
  appliedAt                  DateTime?
  cancelledAt                DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  customer                   Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceSubscription         Subscription          @relation("PlanChangeSourceSubscription", fields: [sourceSubscriptionId], references: [id], onDelete: Restrict)
  newSubscription            Subscription?         @relation("PlanChangeResultSubscription", fields: [newSubscriptionId], references: [id], onDelete: Restrict)
  sourcePlan                 InternetPlan          @relation("PlanChangeSourcePlan", fields: [sourcePlanId], references: [id], onDelete: Restrict)
  targetPlan                 InternetPlan          @relation("PlanChangeTargetPlan", fields: [targetPlanId], references: [id], onDelete: Restrict)
  invoice                    Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payment                    Payment?              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  webhookEvents              PaymentWebhookEvent[]

  @@index([customerId, createdAt])
  @@index([sourceSubscriptionId, status])
  @@index([status, effectiveAt])
  @@index([type, status])
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String   @db.VarChar(100)
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}

model OperatingRegion {
  id                String                    @id @default(uuid()) @db.Uuid
  countryCode       String                    @db.Char(2)
  stateCode         String                    @db.VarChar(3)
  name              String                    @db.VarChar(100)
  status            OperatingRegionStatus     @default(DISABLED)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  postcodeCoverage  PostcodeCoverage[]
  addressOverrides  AddressCoverageOverride[]
  planCoverageRules PlanCoverageRule[]
  coverageSearches  CoverageSearch[]

  @@unique([countryCode, stateCode])
  @@index([status])
}

model PostcodeCoverage {
  id                String                 @id @default(uuid()) @db.Uuid
  operatingRegionId String                 @db.Uuid
  postcode          String                 @db.Char(4)
  status            PostcodeCoverageStatus
  technology        AccessTechnology?
  maximumSpeedMbps  Int?
  availabilityDate  DateTime?              @db.Date
  isActive          Boolean                @default(true)
  adminNotes        String?                @db.VarChar(1000)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  operatingRegion   OperatingRegion        @relation(fields: [operatingRegionId], references: [id], onDelete: Restrict)

  @@unique([operatingRegionId, postcode])
  @@index([postcode, isActive])
  @@index([status, isActive])
}

model AddressCoverageOverride {
  id                String                @id @default(uuid()) @db.Uuid
  operatingRegionId String                @db.Uuid
  provider          String                @db.VarChar(50)
  providerAddressId String                @db.VarChar(255)
  formattedAddress  String                @db.VarChar(500)
  stateCode         String                @db.VarChar(3)
  postcode          String                @db.Char(4)
  status            AddressOverrideStatus
  technology        AccessTechnology?
  maximumSpeedMbps  Int?
  availabilityDate  DateTime?             @db.Date
  isActive          Boolean               @default(true)
  adminNotes        String?               @db.VarChar(1000)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  operatingRegion   OperatingRegion       @relation(fields: [operatingRegionId], references: [id], onDelete: Restrict)

  @@unique([provider, providerAddressId])
  @@index([operatingRegionId, postcode, isActive])
  @@index([status, isActive])
}

model PlanCoverageRule {
  id                String           @id @default(uuid()) @db.Uuid
  planId            String           @db.Uuid
  technology        AccessTechnology
  minimumSpeedMbps  Int?
  maximumSpeedMbps  Int?
  operatingRegionId String?          @db.Uuid
  postcode          String?          @db.Char(4)
  scopeKey          String           @db.VarChar(100)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  plan              InternetPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  operatingRegion   OperatingRegion? @relation(fields: [operatingRegionId], references: [id], onDelete: Cascade)

  @@unique([planId, technology, scopeKey])
  @@index([technology, isActive])
  @@index([operatingRegionId, postcode, isActive])
}

model CoverageSearch {
  id                String               @id @default(uuid()) @db.Uuid
  requestIdentifier String               @default(uuid()) @db.Uuid
  resultStatus      CoverageResultStatus
  stateCode         String?              @db.VarChar(3)
  postcode          String?              @db.Char(4)
  technology        AccessTechnology?
  plansReturned     Boolean              @default(false)
  operatingRegionId String?              @db.Uuid
  customerId        String?              @db.Uuid
  createdAt         DateTime             @default(now())
  operatingRegion   OperatingRegion?     @relation(fields: [operatingRegionId], references: [id], onDelete: SetNull)
  customer          Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([resultStatus, createdAt])
  @@index([stateCode, postcode, createdAt])
  @@index([customerId, createdAt])
}
