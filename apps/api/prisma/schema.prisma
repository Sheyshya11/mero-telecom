generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  CUSTOMER
}

enum CustomerStatus {
  INVITATION_PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserStatus {
  INVITATION_PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AddressType {
  RESIDENTIAL
  SERVICE
  BILLING
}

enum AccountInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AccountInvitationReason {
  ONLINE_PURCHASE
  ADMIN_CREATED
  RESEND
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum CheckoutApplicationStatus {
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  REQUIRES_REVIEW
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLATION_PENDING
  DISCONNECTION_PENDING
  SUSPENDED
  CANCELLED
  TERMINATED
}

enum SuspensionReason {
  NON_PAYMENT
  ADMINISTRATIVE
  FRAUD
  COMPLIANCE
  OTHER
}

enum ServiceProvisioningAction {
  SUSPEND
  RESTORE
}

enum ServiceProvisioningStatus {
  PENDING
  COMPLETED
  FAILED
}

enum CancellationType {
  END_OF_PERIOD
  IMMEDIATE
}

enum CancellationReason {
  MOVING_HOME
  SWITCHING_PROVIDER
  PRICE
  SERVICE_QUALITY
  CONNECTION_PROBLEMS
  NO_LONGER_REQUIRED
  OTHER
}

enum CancellationStatus {
  REQUESTED
  SCHEDULED
  PROCESSING
  DISCONNECTION_PENDING
  COMPLETED
  FAILED
  REVOKED
}

enum CancellationProviderOperation {
  DISCONNECT_SERVICE
  WITHDRAW_ACTIVATION
}

enum CancellationProviderStatus {
  NOT_SUBMITTED
  PENDING
  COMPLETED
  FAILED
  MANUAL_REVIEW_REQUIRED
  CANCELLED
}

enum MockDisconnectionScenario {
  SUCCESS
  PENDING
  FAILED
  MANUAL_REVIEW_REQUIRED
}

enum BillingCycle {
  MONTHLY
}

enum PlanChangeType {
  UPGRADE
  DOWNGRADE
}

enum PlanChangeStatus {
  PENDING
  CHECKOUT_CREATED
  PROCESSING
  SCHEDULED
  APPLIED
  FAILED
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundType {
  FULL
  PARTIAL
}

enum RefundReason {
  DUPLICATE_PAYMENT
  SERVICE_UNAVAILABLE
  BILLING_ERROR
  CANCELLED_BEFORE_ACTIVATION
  SERVICE_ISSUE
  GOODWILL
  OTHER
}

enum RefundStatus {
  DRAFT
  REQUESTED
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  APPROVED
  REJECTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AccessTechnology {
  FTTP
  FTTN
  FTTC
  HFC
  FIXED_WIRELESS
  SATELLITE
}

enum OperatingRegionStatus {
  ACTIVE
  COMING_SOON
  DISABLED
}

enum PostcodeCoverageStatus {
  AVAILABLE
  PARTIAL
  COMING_SOON
  UNAVAILABLE
}

enum AddressOverrideStatus {
  AVAILABLE
  UNAVAILABLE
  MANUAL_REVIEW
}

enum CoverageResultStatus {
  AVAILABLE
  COMING_SOON
  NOT_AVAILABLE
  OUTSIDE_OPERATING_REGION
  MANUAL_REVIEW
}

enum SupportCategory {
  INTERNET_CONNECTION
  BILLING
  PLAN
  ACCOUNT
  REFUND
  PLANS_AND_PRICING
  NBN_AVAILABILITY
  ADDRESS_CHECK
  SIGNUP_HELP
  ORDER_HELP
  PAYMENT_HELP
  GENERAL_ENQUIRY
  OTHER
}

enum SupportRequestType {
  CUSTOMER_SUPPORT
  PROSPECT_ENQUIRY
}

enum SupportMessageVisibility {
  CUSTOMER_VISIBLE
  INTERNAL
}

enum SupportEmailDeliveryStatus {
  NOT_APPLICABLE
  QUEUED
  SENT
  FAILED
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
}

enum InternalRequestType {
  REFUND_REVIEW
  BILLING_REVIEW
  SUBSCRIPTION_ACTION
  CUSTOMER_ACCOUNT_ACTION
  PLAN_CHANGE_REVIEW
  SUPPORT_ASSISTANCE
  OTHER
}

enum InternalRequestStatus {
  PENDING
  IN_REVIEW
  MORE_INFO_REQUIRED
  APPROVED
  REJECTED
  RESOLVED
  CLOSED
}

enum InternalRequestPriority {
  LOW
  NORMAL
  HIGH
}

enum InternalRequestLevel {
  ADMIN
  SUPER_ADMIN
}

enum InternalRequestEventType {
  CREATED
  ASSIGNED
  REVIEW_STARTED
  MESSAGE_SENT
  MORE_INFO_REQUESTED
  APPROVED
  REJECTED
  ESCALATED
  RETURNED
  RESOLVED
  CLOSED
}

model User {
  id                            String                   @id @default(uuid()) @db.Uuid
  email                         String                   @unique @db.VarChar(320)
  displayName                   String?                  @db.VarChar(200)
  passwordHash                  String?                  @db.VarChar(255)
  isActive                      Boolean                  @default(true)
  status                        UserStatus               @default(ACTIVE)
  emailVerifiedAt               DateTime?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  customer                      Customer?
  refreshSessions               RefreshSession[]
  passwordResetTokens           PasswordResetToken[]
  auditLogs                     AuditLog[]               @relation("AuditActor")
  invitations                   AccountInvitation[]      @relation("InvitationUser")
  issuedInvitations             AccountInvitation[]      @relation("InvitationIssuer")
  staffInvitationsIssued        StaffInvitation[]        @relation("StaffInvitationIssuer")
  staffInvitationsAccepted      StaffInvitation[]        @relation("StaffInvitationAcceptor")
  refundRequests                Refund[]                 @relation("RefundRequester")
  refundApprovals               Refund[]                 @relation("RefundApprover")
  refundsProcessed              Refund[]                 @relation("RefundProcessor")
  refundsRejected               Refund[]                 @relation("RefundRejector")
  refundAttachments             RefundAttachment[]       @relation("RefundAttachmentUploader")
  roles                         UserRole[]
  assignedSupportCases          SupportCase[]            @relation("SupportCaseAssignee")
  linkedProspectSupportCases    SupportCase[]            @relation("SupportCaseCustomerLinker")
  supportMessages               SupportMessage[]
  internalRequestsCreated       InternalRequest[]        @relation("InternalRequestRequester")
  internalRequestsAssigned      InternalRequest[]        @relation("InternalRequestAssignee")
  internalRequestsSuperAssigned InternalRequest[]        @relation("InternalRequestSuperAdminAssignee")
  internalRequestsReviewed      InternalRequest[]        @relation("InternalRequestReviewer")
  internalRequestsEscalated     InternalRequest[]        @relation("InternalRequestEscalator")
  internalRequestMessages       InternalRequestMessage[]
  internalRequestEvents         InternalRequestEvent[]
  cancellationRequestsMade      CancellationRequest[]    @relation("CancellationRequester")
  cancellationRequestsRevoked   CancellationRequest[]    @relation("CancellationRevoker")
  cancellationNotes             CancellationNote[]

  @@index([createdAt, id])
}

model UserRole {
  userId     String   @db.Uuid
  role       Role
  assignedAt DateTime @default(now())
  assignedBy String?  @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role, userId])
}

model Customer {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String?               @unique @db.Uuid
  stripeCustomerId     String?               @unique @db.VarChar(255)
  customerNumber       String                @unique @db.VarChar(32)
  firstName            String                @db.VarChar(100)
  lastName             String                @db.VarChar(100)
  email                String                @unique @db.VarChar(320)
  phone                String                @db.VarChar(32)
  addressLine1         String                @db.VarChar(255)
  addressLine2         String?               @db.VarChar(255)
  suburb               String                @db.VarChar(100)
  state                String                @db.VarChar(3)
  postcode             String                @db.VarChar(10)
  status               CustomerStatus        @default(ACTIVE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptions        Subscription[]
  invoices             Invoice[]
  payments             Payment[]
  addresses            CustomerAddress[]
  checkoutApplications CheckoutApplication[]
  planChangeRequests   PlanChangeRequest[]
  coverageSearches     CoverageSearch[]
  refunds              Refund[]
  supportCases         SupportCase[]
  internalRequests     InternalRequest[]
  cancellationRequests CancellationRequest[]

  @@index([lastName, firstName])
  @@index([status])
  @@index([createdAt, id])
  @@index([state, postcode])
}

model SupportCaseSequence {
  year  Int @id
  value Int
}

model SupportCase {
  id                      String             @id @default(uuid()) @db.Uuid
  caseNumber              String             @unique @db.VarChar(32)
  requestType             SupportRequestType @default(CUSTOMER_SUPPORT)
  customerId              String?            @db.Uuid
  prospectName            String?            @db.VarChar(200)
  prospectEmail           String?            @db.VarChar(320)
  prospectPhone           String?            @db.VarChar(32)
  prospectAddress         String?            @db.VarChar(300)
  publicSubmissionKeyHash String?            @unique @db.Char(64)
  linkedCustomerAt        DateTime?
  linkedCustomerByUserId  String?            @db.Uuid
  category                SupportCategory
  subject                 String             @db.VarChar(200)
  status                  SupportStatus      @default(OPEN)
  priority                SupportPriority    @default(NORMAL)
  assignedToUserId        String?            @db.Uuid
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  resolvedAt              DateTime?
  closedAt                DateTime?
  customer                Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedTo              User?              @relation("SupportCaseAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  linkedCustomerByUser    User?              @relation("SupportCaseCustomerLinker", fields: [linkedCustomerByUserId], references: [id], onDelete: SetNull)
  messages                SupportMessage[]
  internalRequests        InternalRequest[]

  @@index([customerId, updatedAt, id])
  @@index([status, updatedAt, id])
  @@index([assignedToUserId, status, updatedAt])
  @@index([category, status])
  @@index([requestType, status, updatedAt, id])
  @@index([prospectEmail, createdAt])
}

model SupportMessage {
  id                  String                     @id @default(uuid()) @db.Uuid
  supportCaseId       String                     @db.Uuid
  senderUserId        String?                    @db.Uuid
  senderRole          Role
  visibility          SupportMessageVisibility   @default(CUSTOMER_VISIBLE)
  emailDeliveryStatus SupportEmailDeliveryStatus @default(NOT_APPLICABLE)
  body                String                     @db.VarChar(5000)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  supportCase         SupportCase                @relation(fields: [supportCaseId], references: [id], onDelete: Cascade)
  sender              User?                      @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  attachments         SupportAttachment[]

  @@index([supportCaseId, createdAt, id])
  @@index([senderUserId, createdAt])
}

model SupportAttachment {
  id           String         @id @default(uuid()) @db.Uuid
  messageId    String         @db.Uuid
  originalName String         @db.VarChar(255)
  storageKey   String         @unique @db.VarChar(500)
  mimeType     String         @db.VarChar(120)
  fileSize     Int
  createdAt    DateTime       @default(now())
  message      SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
}

model InternalRequestSequence {
  year  Int @id
  value Int
}

model InternalRequest {
  id                         String                   @id @default(uuid()) @db.Uuid
  requestNumber              String                   @unique @db.VarChar(32)
  requestedByUserId          String                   @db.Uuid
  requesterRole              Role
  targetRole                 Role                     @default(ADMIN)
  currentLevel               InternalRequestLevel     @default(ADMIN)
  assignedToUserId           String?                  @db.Uuid
  superAdminAssignedToUserId String?                  @db.Uuid
  reviewedByUserId           String?                  @db.Uuid
  escalatedByUserId          String?                  @db.Uuid
  type                       InternalRequestType
  title                      String                   @db.VarChar(200)
  description                String                   @db.VarChar(5000)
  priority                   InternalRequestPriority  @default(NORMAL)
  status                     InternalRequestStatus    @default(PENDING)
  supportCaseId              String?                  @db.Uuid
  customerId                 String?                  @db.Uuid
  subscriptionId             String?                  @db.Uuid
  invoiceId                  String?                  @db.Uuid
  paymentId                  String?                  @db.Uuid
  refundId                   String?                  @db.Uuid
  planChangeRequestId        String?                  @db.Uuid
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  reviewedAt                 DateTime?
  escalatedAt                DateTime?
  resolvedAt                 DateTime?
  closedAt                   DateTime?
  requestedBy                User                     @relation("InternalRequestRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  assignedTo                 User?                    @relation("InternalRequestAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  superAdminAssignedTo       User?                    @relation("InternalRequestSuperAdminAssignee", fields: [superAdminAssignedToUserId], references: [id], onDelete: SetNull)
  reviewedBy                 User?                    @relation("InternalRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  escalatedBy                User?                    @relation("InternalRequestEscalator", fields: [escalatedByUserId], references: [id], onDelete: SetNull)
  supportCase                SupportCase?             @relation(fields: [supportCaseId], references: [id], onDelete: Restrict)
  customer                   Customer?                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subscription               Subscription?            @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  invoice                    Invoice?                 @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payment                    Payment?                 @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refund                     Refund?                  @relation(fields: [refundId], references: [id], onDelete: Restrict)
  planChangeRequest          PlanChangeRequest?       @relation(fields: [planChangeRequestId], references: [id], onDelete: Restrict)
  messages                   InternalRequestMessage[]
  events                     InternalRequestEvent[]

  @@index([requestedByUserId, updatedAt, id])
  @@index([assignedToUserId, status, updatedAt])
  @@index([superAdminAssignedToUserId, status, updatedAt])
  @@index([targetRole, status, priority, createdAt])
  @@index([currentLevel, status, priority, escalatedAt])
  @@index([customerId, createdAt])
  @@index([supportCaseId])
  @@index([invoiceId])
  @@index([paymentId])
  @@index([refundId])
  @@index([subscriptionId])
  @@index([planChangeRequestId])
}

model InternalRequestMessage {
  id                String                      @id @default(uuid()) @db.Uuid
  internalRequestId String                      @db.Uuid
  senderUserId      String                      @db.Uuid
  senderRole        Role
  body              String                      @db.VarChar(5000)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  internalRequest   InternalRequest             @relation(fields: [internalRequestId], references: [id], onDelete: Cascade)
  sender            User                        @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  attachments       InternalRequestAttachment[]

  @@index([internalRequestId, createdAt, id])
  @@index([senderUserId, createdAt])
}

model InternalRequestAttachment {
  id           String                 @id @default(uuid()) @db.Uuid
  messageId    String                 @db.Uuid
  originalName String                 @db.VarChar(255)
  storageKey   String                 @unique @db.VarChar(500)
  mimeType     String                 @db.VarChar(120)
  fileSize     Int
  createdAt    DateTime               @default(now())
  message      InternalRequestMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
}

model InternalRequestEvent {
  id                String                   @id @default(uuid()) @db.Uuid
  internalRequestId String                   @db.Uuid
  actorUserId       String                   @db.Uuid
  actorRole         Role
  eventType         InternalRequestEventType
  fromLevel         InternalRequestLevel?
  toLevel           InternalRequestLevel?
  comment           String?                  @db.VarChar(2000)
  createdAt         DateTime                 @default(now())
  internalRequest   InternalRequest          @relation(fields: [internalRequestId], references: [id], onDelete: Cascade)
  actor             User                     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([internalRequestId, createdAt, id])
  @@index([actorUserId, createdAt])
}

model CustomerAddress {
  id           String      @id @default(uuid()) @db.Uuid
  customerId   String      @db.Uuid
  type         AddressType
  addressLine1 String      @db.VarChar(255)
  addressLine2 String?     @db.VarChar(255)
  suburb       String      @db.VarChar(100)
  state        String      @db.VarChar(3)
  postcode     String      @db.VarChar(10)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, type])
  @@index([postcode])
}

model InvoiceDocument {
  id         String   @id @default(uuid()) @db.Uuid
  invoiceId  String   @unique @db.Uuid
  storageKey String   @unique @db.VarChar(1024)
  mimeType   String   @db.VarChar(255)
  sizeBytes  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model InternetPlan {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String                @unique @db.VarChar(150)
  description          String?               @db.Text
  highlights           String[]              @default([])
  downloadMbps         Int
  uploadMbps           Int
  monthlyCents         Int
  isActive             Boolean               @default(true)
  isPublic             Boolean               @default(true)
  isAvailable          Boolean               @default(true)
  tierRank             Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  subscriptions        Subscription[]
  purchaseInvoices     Invoice[]             @relation("InvoicePurchasePlan")
  checkoutApplications CheckoutApplication[]
  sourcePlanChanges    PlanChangeRequest[]   @relation("PlanChangeSourcePlan")
  targetPlanChanges    PlanChangeRequest[]   @relation("PlanChangeTargetPlan")
  coverageRules        PlanCoverageRule[]

  @@index([isActive])
  @@index([isPublic, isAvailable, tierRank])
}

model Subscription {
  id                        String                       @id @default(uuid()) @db.Uuid
  customerId                String                       @db.Uuid
  planId                    String                       @db.Uuid
  status                    SubscriptionStatus           @default(PENDING)
  startDate                 DateTime                     @db.Date
  endDate                   DateTime?                    @db.Date
  endReason                 String?                      @db.VarChar(100)
  billingCycle              BillingCycle                 @default(MONTHLY)
  billingAnchorDay          Int
  currentPeriodStart        DateTime
  currentPeriodEnd          DateTime
  pastDueAt                 DateTime?
  gracePeriodEndsAt         DateTime?
  suspendedAt               DateTime?
  suspensionReason          SuspensionReason?
  reactivatedAt             DateTime?
  eligibleForTerminationAt  DateTime?
  terminationReviewQueuedAt DateTime?
  overdueReminderStage      Int                          @default(0)
  suspensionWarningSentAt   DateTime?
  provisioningStatus        ServiceProvisioningStatus?
  provisioningFailure       String?                      @db.VarChar(500)
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  customer                  Customer                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan                      InternetPlan                 @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices                  Invoice[]
  checkoutApplication       CheckoutApplication?
  sourcePlanChanges         PlanChangeRequest[]          @relation("PlanChangeSourceSubscription")
  resultingPlanChange       PlanChangeRequest?           @relation("PlanChangeResultSubscription")
  refunds                   Refund[]
  internalRequests          InternalRequest[]
  cancellationRequests      CancellationRequest[]
  provisioningRequests      ServiceProvisioningRequest[]

  @@index([customerId, status])
  @@index([status, gracePeriodEndsAt, id])
  @@index([status, eligibleForTerminationAt, id])
  @@index([planId])
  @@index([createdAt, id])
}

model ServiceProvisioningRequest {
  id             String                    @id @default(uuid()) @db.Uuid
  subscriptionId String                    @db.Uuid
  action         ServiceProvisioningAction
  status         ServiceProvisioningStatus @default(PENDING)
  idempotencyKey String                    @unique @db.VarChar(180)
  provider       String                    @default("MOCK") @db.VarChar(50)
  attemptCount   Int                       @default(0)
  failureReason  String?                   @db.VarChar(500)
  requestedAt    DateTime                  @default(now())
  lastAttemptAt  DateTime?
  completedAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  subscription   Subscription              @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([status, updatedAt, id])
  @@index([subscriptionId, createdAt])
}

model CancellationRequestSequence {
  year  Int @id
  value Int
}

model CancellationRequest {
  id                       String                        @id @default(uuid()) @db.Uuid
  requestNumber            String                        @unique @db.VarChar(32)
  subscriptionId           String                        @db.Uuid
  customerId               String                        @db.Uuid
  type                     CancellationType
  reason                   CancellationReason
  reasonDetails            String?                       @db.VarChar(2000)
  requestedAt              DateTime                      @default(now())
  requestedByUserId        String                        @db.Uuid
  requestedByRole          Role
  effectiveAt              DateTime
  status                   CancellationStatus            @default(REQUESTED)
  providerOperation        CancellationProviderOperation
  subscriptionStatusBefore SubscriptionStatus
  providerName             String                        @default("MOCK_NBN") @db.VarChar(50)
  providerIdempotencyKey   String                        @unique @db.VarChar(150)
  providerDisconnectionId  String?                       @unique @db.VarChar(255)
  providerStatus           CancellationProviderStatus    @default(NOT_SUBMITTED)
  providerScenario         MockDisconnectionScenario?
  providerPayload          Json?
  providerLastCheckedAt    DateTime?
  failedReason             String?                       @db.VarChar(500)
  processingStartedAt      DateTime?
  completedAt              DateTime?
  revokedAt                DateTime?
  revokedByUserId          String?                       @db.Uuid
  attemptCount             Int                           @default(0)
  version                  Int                           @default(0)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  subscription             Subscription                  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  customer                 Customer                      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  requestedBy              User                          @relation("CancellationRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  revokedBy                User?                         @relation("CancellationRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  notes                    CancellationNote[]

  @@index([customerId, createdAt, id])
  @@index([subscriptionId, createdAt])
  @@index([status, effectiveAt, id])
  @@index([providerStatus, updatedAt, id])
  @@index([reason, createdAt])
  @@index([type, createdAt])
}

model CancellationNote {
  id                    String              @id @default(uuid()) @db.Uuid
  cancellationRequestId String              @db.Uuid
  authorUserId          String              @db.Uuid
  authorRole            Role
  body                  String              @db.VarChar(2000)
  createdAt             DateTime            @default(now())
  cancellationRequest   CancellationRequest @relation(fields: [cancellationRequestId], references: [id], onDelete: Cascade)
  author                User                @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([cancellationRequestId, createdAt, id])
  @@index([authorUserId, createdAt])
}

model Invoice {
  id                  String               @id @default(uuid()) @db.Uuid
  invoiceNumber       String               @unique @db.VarChar(32)
  customerId          String               @db.Uuid
  subscriptionId      String?              @db.Uuid
  purchasePlanId      String?              @db.Uuid
  issueDate           DateTime             @db.Date
  dueDate             DateTime             @db.Date
  subtotalCents       Int
  taxCents            Int
  totalCents          Int
  currency            String               @default("AUD") @db.Char(3)
  status              InvoiceStatus        @default(DRAFT)
  pdfUrl              String?              @db.VarChar(2048)
  issuedAt            DateTime?
  paidAt              DateTime?
  overdueAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subscription        Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  purchasePlan        InternetPlan?        @relation("InvoicePurchasePlan", fields: [purchasePlanId], references: [id], onDelete: Restrict)
  items               InvoiceItem[]
  payments            Payment[]
  documents           InvoiceDocument[]
  checkoutApplication CheckoutApplication?
  planChangeRequest   PlanChangeRequest?
  refunds             Refund[]
  internalRequests    InternalRequest[]

  @@unique([subscriptionId, issueDate])
  @@index([createdAt, id])
  @@index([customerId, status])
  @@index([dueDate, status])
  @@index([issuedAt, status])
  @@index([subscriptionId])
  @@index([purchasePlanId])
}

model InvoiceItem {
  id             String  @id @default(uuid()) @db.Uuid
  invoiceId      String  @db.Uuid
  description    String  @db.VarChar(500)
  quantity       Int
  unitPriceCents Int
  amountCents    Int
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id                  String                @id @default(uuid()) @db.Uuid
  invoiceId           String                @db.Uuid
  customerId          String                @db.Uuid
  provider            PaymentProvider
  providerPaymentId   String?               @db.VarChar(255)
  providerSessionId   String?               @unique @db.VarChar(255)
  amountCents         Int
  currency            String                @default("AUD") @db.Char(3)
  status              PaymentStatus         @default(PENDING)
  refundedCents       Int                   @default(0)
  paidAt              DateTime?
  createdAt           DateTime              @default(now())
  invoice             Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customer            Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  webhookEvents       PaymentWebhookEvent[]
  checkoutApplication CheckoutApplication?
  planChangeRequest   PlanChangeRequest?
  refunds             Refund[]
  internalRequests    InternalRequest[]

  @@unique([provider, providerPaymentId])
  @@index([invoiceId, status])
  @@index([customerId])
  @@index([status, paidAt])
  @@index([createdAt, id])
}

model Refund {
  id                    String                @id @default(uuid()) @db.Uuid
  customerId            String                @db.Uuid
  paymentId             String                @db.Uuid
  invoiceId             String?               @db.Uuid
  subscriptionId        String?               @db.Uuid
  stripePaymentIntentId String                @db.VarChar(255)
  stripeChargeId        String?               @db.VarChar(255)
  stripeRefundId        String?               @unique @db.VarChar(255)
  originalAmountCents   Int
  refundAmountCents     Int
  currency              String                @db.Char(3)
  type                  RefundType
  reason                RefundReason
  customerReason        String?               @db.VarChar(2000)
  internalNote          String?               @db.VarChar(2000)
  customerMessage       String?               @db.VarChar(2000)
  status                RefundStatus          @default(REQUESTED)
  requestedByUserId     String?               @db.Uuid
  approvedByUserId      String?               @db.Uuid
  processedByUserId     String?               @db.Uuid
  rejectedByUserId      String?               @db.Uuid
  requestedAt           DateTime              @default(now())
  approvedAt            DateTime?
  processedAt           DateTime?
  rejectedAt            DateTime?
  failedAt              DateTime?
  failureReason         String?               @db.VarChar(500)
  processingAttempt     Int                   @default(0)
  metadata              Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  customer              Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payment               Payment               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice               Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  subscription          Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  requestedBy           User?                 @relation("RefundRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  approvedBy            User?                 @relation("RefundApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  processedBy           User?                 @relation("RefundProcessor", fields: [processedByUserId], references: [id], onDelete: SetNull)
  rejectedBy            User?                 @relation("RefundRejector", fields: [rejectedByUserId], references: [id], onDelete: SetNull)
  webhookEvents         PaymentWebhookEvent[]
  attachments           RefundAttachment[]
  internalRequests      InternalRequest[]

  @@index([customerId, createdAt])
  @@index([paymentId, status])
  @@index([invoiceId])
  @@index([subscriptionId])
  @@index([status, createdAt])
  @@index([status, processedAt])
  @@index([reason, createdAt])
  @@index([createdAt, id])
}

model RefundAttachment {
  id             String    @id @default(uuid()) @db.Uuid
  refundId       String    @db.Uuid
  originalName   String    @db.VarChar(255)
  storageKey     String    @db.VarChar(500)
  mimeType       String    @db.VarChar(120)
  fileSize       Int
  uploadedById   String    @db.Uuid
  uploadedByRole Role
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  refund     Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("RefundAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([refundId, createdAt])
  @@index([uploadedById, createdAt])
}

model CheckoutApplication {
  id                      String                    @id @default(uuid()) @db.Uuid
  planId                  String                    @db.Uuid
  applicantEmail          String                    @db.VarChar(320)
  firstName               String                    @db.VarChar(100)
  lastName                String                    @db.VarChar(100)
  phone                   String                    @db.VarChar(32)
  residentialAddress      Json
  serviceAddress          Json
  billingAddress          Json
  termsAcceptedAt         DateTime
  privacyAcceptedAt       DateTime
  status                  CheckoutApplicationStatus @default(PENDING_PAYMENT)
  amountCents             Int
  currency                String                    @default("AUD") @db.Char(3)
  stripeCheckoutSessionId String?                   @unique @db.VarChar(255)
  stripePaymentIntentId   String?                   @unique @db.VarChar(255)
  stripeCustomerId        String?                   @db.VarChar(255)
  customerId              String?                   @unique @db.Uuid
  invoiceId               String?                   @unique @db.Uuid
  paymentId               String?                   @unique @db.Uuid
  subscriptionId          String?                   @unique @db.Uuid
  expiresAt               DateTime
  completedAt             DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  plan                    InternetPlan              @relation(fields: [planId], references: [id], onDelete: Restrict)
  customer                Customer?                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice                 Invoice?                  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payment                 Payment?                  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  subscription            Subscription?             @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  invitations             AccountInvitation[]

  @@index([status, expiresAt])
  @@index([applicantEmail])
  @@index([createdAt])
}

model AccountInvitation {
  id                    String                  @id @default(uuid()) @db.Uuid
  userId                String                  @db.Uuid
  tokenHash             String                  @unique @db.Char(64)
  status                AccountInvitationStatus @default(PENDING)
  reason                AccountInvitationReason
  createdByUserId       String?                 @db.Uuid
  checkoutApplicationId String?                 @db.Uuid
  expiresAt             DateTime
  sentAt                DateTime?
  acceptedAt            DateTime?
  createdAt             DateTime                @default(now())
  user                  User                    @relation("InvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy             User?                   @relation("InvitationIssuer", fields: [createdByUserId], references: [id], onDelete: SetNull)
  checkoutApplication   CheckoutApplication?    @relation(fields: [checkoutApplicationId], references: [id], onDelete: SetNull)

  @@index([userId, status, expiresAt])
  @@index([createdByUserId, createdAt])
}

model StaffInvitation {
  id           String                @id @default(uuid()) @db.Uuid
  email        String                @db.VarChar(320)
  role         Role
  tokenHash    String                @unique @db.Char(64)
  status       StaffInvitationStatus @default(PENDING)
  expiresAt    DateTime
  invitedById  String?               @db.Uuid
  acceptedById String?               @db.Uuid
  acceptedAt   DateTime?
  revokedAt    DateTime?
  sentAt       DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  invitedBy    User?                 @relation("StaffInvitationIssuer", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy   User?                 @relation("StaffInvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([email, status, expiresAt])
  @@index([invitedById, createdAt])
  @@index([status, expiresAt])
}

model PaymentWebhookEvent {
  id                  String             @id @default(uuid()) @db.Uuid
  provider            PaymentProvider
  providerEventId     String             @unique @db.VarChar(255)
  eventType           String             @db.VarChar(100)
  paymentId           String?            @db.Uuid
  planChangeRequestId String?            @db.Uuid
  refundId            String?            @db.Uuid
  processedAt         DateTime           @default(now())
  payment             Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  planChangeRequest   PlanChangeRequest? @relation(fields: [planChangeRequestId], references: [id], onDelete: SetNull)
  refund              Refund?            @relation(fields: [refundId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([planChangeRequestId])
  @@index([refundId])
}

model PlanChangeRequest {
  id                         String                @id @default(uuid()) @db.Uuid
  customerId                 String                @db.Uuid
  sourceSubscriptionId       String                @db.Uuid
  newSubscriptionId          String?               @unique @db.Uuid
  sourcePlanId               String                @db.Uuid
  targetPlanId               String                @db.Uuid
  type                       PlanChangeType
  status                     PlanChangeStatus      @default(PENDING)
  currency                   String                @default("AUD") @db.Char(3)
  sourcePlanPriceCents       Int
  targetPlanPriceCents       Int
  unusedCreditCents          Int
  proratedTargetCents        Int
  amountPayableCents         Int
  currentPeriodStartSnapshot DateTime
  currentPeriodEndSnapshot   DateTime
  requestedAt                DateTime              @default(now())
  effectiveAt                DateTime
  stripeCheckoutSessionId    String?               @unique @db.VarChar(255)
  stripePaymentIntentId      String?               @unique @db.VarChar(255)
  invoiceId                  String?               @unique @db.Uuid
  paymentId                  String?               @unique @db.Uuid
  failureReason              String?               @db.VarChar(255)
  cancellationReason         String?               @db.VarChar(255)
  appliedAt                  DateTime?
  cancelledAt                DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  customer                   Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceSubscription         Subscription          @relation("PlanChangeSourceSubscription", fields: [sourceSubscriptionId], references: [id], onDelete: Restrict)
  newSubscription            Subscription?         @relation("PlanChangeResultSubscription", fields: [newSubscriptionId], references: [id], onDelete: Restrict)
  sourcePlan                 InternetPlan          @relation("PlanChangeSourcePlan", fields: [sourcePlanId], references: [id], onDelete: Restrict)
  targetPlan                 InternetPlan          @relation("PlanChangeTargetPlan", fields: [targetPlanId], references: [id], onDelete: Restrict)
  invoice                    Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payment                    Payment?              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  webhookEvents              PaymentWebhookEvent[]
  internalRequests           InternalRequest[]

  @@index([customerId, createdAt])
  @@index([sourceSubscriptionId, status])
  @@index([status, effectiveAt])
  @@index([status, appliedAt])
  @@index([type, status])
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String   @db.VarChar(100)
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([createdAt, id])
}

model OperatingRegion {
  id                String                    @id @default(uuid()) @db.Uuid
  countryCode       String                    @db.Char(2)
  stateCode         String                    @db.VarChar(3)
  name              String                    @db.VarChar(100)
  status            OperatingRegionStatus     @default(DISABLED)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  postcodeCoverage  PostcodeCoverage[]
  addressOverrides  AddressCoverageOverride[]
  planCoverageRules PlanCoverageRule[]
  coverageSearches  CoverageSearch[]

  @@unique([countryCode, stateCode])
  @@index([status])
}

model PostcodeCoverage {
  id                String                 @id @default(uuid()) @db.Uuid
  operatingRegionId String                 @db.Uuid
  postcode          String                 @db.Char(4)
  status            PostcodeCoverageStatus
  technology        AccessTechnology?
  maximumSpeedMbps  Int?
  availabilityDate  DateTime?              @db.Date
  isActive          Boolean                @default(true)
  adminNotes        String?                @db.VarChar(1000)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  operatingRegion   OperatingRegion        @relation(fields: [operatingRegionId], references: [id], onDelete: Restrict)

  @@unique([operatingRegionId, postcode])
  @@index([postcode, isActive])
  @@index([status, isActive])
}

model AddressCoverageOverride {
  id                String                @id @default(uuid()) @db.Uuid
  operatingRegionId String                @db.Uuid
  provider          String                @db.VarChar(50)
  providerAddressId String                @db.VarChar(255)
  formattedAddress  String                @db.VarChar(500)
  stateCode         String                @db.VarChar(3)
  postcode          String                @db.Char(4)
  status            AddressOverrideStatus
  technology        AccessTechnology?
  maximumSpeedMbps  Int?
  availabilityDate  DateTime?             @db.Date
  isActive          Boolean               @default(true)
  adminNotes        String?               @db.VarChar(1000)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  operatingRegion   OperatingRegion       @relation(fields: [operatingRegionId], references: [id], onDelete: Restrict)

  @@unique([provider, providerAddressId])
  @@index([operatingRegionId, postcode, isActive])
  @@index([status, isActive])
}

model PlanCoverageRule {
  id                String           @id @default(uuid()) @db.Uuid
  planId            String           @db.Uuid
  technology        AccessTechnology
  minimumSpeedMbps  Int?
  maximumSpeedMbps  Int?
  operatingRegionId String?          @db.Uuid
  postcode          String?          @db.Char(4)
  scopeKey          String           @db.VarChar(100)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  plan              InternetPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  operatingRegion   OperatingRegion? @relation(fields: [operatingRegionId], references: [id], onDelete: Cascade)

  @@unique([planId, technology, scopeKey])
  @@index([technology, isActive])
  @@index([operatingRegionId, postcode, isActive])
}

model CoverageSearch {
  id                String               @id @default(uuid()) @db.Uuid
  requestIdentifier String               @default(uuid()) @db.Uuid
  resultStatus      CoverageResultStatus
  stateCode         String?              @db.VarChar(3)
  postcode          String?              @db.Char(4)
  technology        AccessTechnology?
  plansReturned     Boolean              @default(false)
  operatingRegionId String?              @db.Uuid
  customerId        String?              @db.Uuid
  createdAt         DateTime             @default(now())
  operatingRegion   OperatingRegion?     @relation(fields: [operatingRegionId], references: [id], onDelete: SetNull)
  customer          Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([resultStatus, createdAt])
  @@index([stateCode, postcode, createdAt])
  @@index([customerId, createdAt])
}
