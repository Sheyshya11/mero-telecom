    "@types/jest": "30.0.0",
    "@types/node": "26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "jest": "30.2.0",
    "prisma": "6.19.3",
    "supertest": "^7.2.2",
    "ts-jest": "29.4.6",
