# Shared local development services
DATABASE_URL="postgresql://mero_telecom:mero_telecom_dev_password@localhost:5432/mero_telecom?schema=public"
REDIS_URL="redis://localhost:6379"
ADMIN_DASHBOARD_CACHE_TTL_SECONDS="60"
THROTTLE_TTL_MS="60000"
THROTTLE_LIMIT="120"

# API configuration (required when the API configuration module is introduced)
NODE_ENV="development"
PORT="3001"
# In production, use the exact HTTPS frontend origin (scheme + host, without a path).
FRONTEND_URL="http://localhost:3000"
JWT_ACCESS_SECRET="replace-with-a-long-unique-development-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-unique-development-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Stripe sandbox only: never use live (sk_live_) credentials in this prototype.
# Prefer a restricted test key (rk_test_) with only the permissions this service needs.
STRIPE_SECRET_KEY="rk_test_replace-with-your-stripe-test-key"
STRIPE_WEBHOOK_SECRET="whsec_replace-with-your-webhook-signing-secret"

# Invoice email delivery. Local development uses Mailpit and redirects every invoice email to
# EMAIL_DEV_RECIPIENT so test messages cannot reach customer addresses accidentally.
# To exercise the real SMTP path with Resend during development, use smtp.resend.com:465,
# SMTP_SECURE=true, SMTP_USER=resend, EMAIL_FROM="Mero Telecom Billing <onboarding@resend.dev>",
# and set EMAIL_DEV_RECIPIENT to the email address that owns the Resend account. The shared
# resend.dev sender cannot deliver to arbitrary recipients.
EMAIL_FROM="Mero Telecom Billing <billing@merotelecom.test>"
EMAIL_DEV_RECIPIENT="developer@example.com"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Private S3-compatible invoice document storage. Required in production.
S3_ENDPOINT=""
S3_REGION="ap-southeast-2"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Web configuration. This is the only application variable exposed in the browser bundle.
# Vercel builds require an HTTPS API URL; localhost HTTP remains valid for local builds.
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
