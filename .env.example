# Shared local development services
DATABASE_URL="postgresql://mero_telecom:mero_telecom_dev_password@localhost:5432/mero_telecom?schema=public"
REDIS_URL="redis://localhost:6379"
ADMIN_DASHBOARD_CACHE_TTL_SECONDS="60"
THROTTLE_TTL_MS="60000"
THROTTLE_LIMIT="120"
ACCOUNT_INVITATION_TTL_HOURS="24"
STAFF_INVITATION_TTL_HOURS="48"
ENHANCED_AUTH_MAX_AGE_SECONDS="600"

# Optional one-time local-auth super-administrator bootstrap. It creates an invitation, never a password.
BOOTSTRAP_SUPER_ADMIN_EMAIL=""
BOOTSTRAP_SUPER_ADMIN_NAME="Mero Telecom Super Administrator"
# Deprecated compatibility aliases. Prefer BOOTSTRAP_SUPER_ADMIN_*.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME="Mero Telecom Administrator"
# Break-glass recovery for an existing super administrator. Remove after deliberate use.
RECOVERY_SUPER_ADMIN_EMAIL=""
# Deprecated compatibility alias. Prefer RECOVERY_SUPER_ADMIN_EMAIL.
RECOVERY_ADMIN_EMAIL=""

# Server-side Australian address autocomplete and database-owned coverage qualification.
# Obtain a Geoapify key from https://myprojects.geoapify.com/ and never expose it through a
# NEXT_PUBLIC_ variable. Development may leave the key blank, but autocomplete then returns 503.
ADDRESS_LOOKUP_PROVIDER="geoapify"
GEOAPIFY_API_KEY=""
COVERAGE_QUALIFICATION_PROVIDER="database"
ADDRESS_LOOKUP_MIN_CHARACTERS="3"
ADDRESS_LOOKUP_CACHE_TTL_SECONDS="600"
ADDRESS_SELECTION_TTL_SECONDS="900"
PUBLIC_CHECKOUT_CONTEXT_TTL_SECONDS="1800"

# API configuration (required when the API configuration module is introduced)
NODE_ENV="development"
PORT="3001"
# In production, use the exact HTTPS frontend origin (scheme + host, without a path).
FRONTEND_URL="http://localhost:3000"
JWT_ACCESS_SECRET="replace-with-a-long-unique-development-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-unique-development-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Stripe sandbox only: never use live (sk_live_) credentials in this prototype.
# Prefer a restricted test key (rk_test_) with only the permissions this service needs.
STRIPE_SECRET_KEY="rk_test_replace-with-your-stripe-test-key"
STRIPE_WEBHOOK_SECRET="whsec_replace-with-your-webhook-signing-secret"

# Email delivery. `redirect` sends every local message to EMAIL_DEV_RECIPIENT. `direct` sends to
# the address supplied by the customer and therefore requires an SMTP account allowed to deliver
# to arbitrary recipients. Production accepts direct mode only.
# To exercise the real SMTP path with Resend during development, use smtp.resend.com:465,
# SMTP_SECURE=true, SMTP_USER=resend, EMAIL_FROM="Mero Telecom Billing <onboarding@resend.dev>",
# and set EMAIL_DEV_RECIPIENT to the email address that owns the Resend account. The shared
# resend.dev sender cannot deliver to arbitrary recipients.
# For dynamic Gmail testing, set EMAIL_DELIVERY_MODE=direct, smtp.gmail.com:465,
# SMTP_SECURE=true, the full Gmail address for SMTP_USER and EMAIL_FROM, and a Google App Password
# (never the normal account password) in SMTP_PASS.
EMAIL_FROM="Mero Telecom Billing <billing@merotelecom.test>"
EMAIL_DELIVERY_MODE="redirect"
EMAIL_DEV_RECIPIENT="developer@example.com"
EMAIL_QUEUE_ATTEMPTS="3"
EMAIL_QUEUE_BACKOFF_MS="3000"
EMAIL_QUEUE_CONCURRENCY="3"
# Required in production. Use a unique secret of at least 32 characters; never commit it.
EMAIL_QUEUE_ENCRYPTION_KEY=""
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER="MeroTelecom"
SMTP_PASS=""

# Private S3-compatible invoice document storage. Required in production.
S3_ENDPOINT=""
S3_REGION="ap-southeast-2"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Web configuration. This is the only application variable exposed in the browser bundle.
# Vercel builds require an HTTPS API URL; localhost HTTP remains valid for local builds.
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
